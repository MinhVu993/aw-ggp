# ============================================================
# FAC - Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# --- Next.js App ---
# The basePath configured in next.config.mjs (must match)
NEXT_PUBLIC_BASE_PATH=/ps/fac

# --- Portal Integration (External Auth System) ---
# Base URL of the Portal API (e.g. http://your-server.com/api)
NEXT_PUBLIC_PORTAL_API_URL=http://your-portal-server.com/api

# Base URL of the Portal homepage (used for login redirects)
NEXT_PUBLIC_PORTAL_URL=http://your-portal-server.com

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/fac_db
# OR individual vars:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=fac_db
# PGUSER=user
# PGPASSWORD=password

# --- Services ---
# Public host URL (used to build download links in emails, e.g. http://10.1.16.89)
NEXT_PUBLIC_HOST_URL=http://your-server-ip

# MSG Center API URL (required for email reports)
MSG_CENTER_URL=http://your-msg-center-server.com/api/msg-center/sendOutMsg
